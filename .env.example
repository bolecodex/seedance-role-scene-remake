# seedance-role-scene-remake — copy to .env and fill locally.

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com

# Seedance model or endpoint ID.
SEEDANCE_ROLE_SCENE_MODEL=doubao-seedance-2-0-260128
# Also accepted:
# SEEDANCE_MODEL=
# SEEDANCE_ENDPOINT=
SEEDANCE_ROLE_SCENE_RESOLUTION=720p

# Optional source-video analysis models used by `analyze`.
SEEDANCE_ROLE_SCENE_ANALYSIS_MODEL=
SEEDANCE_ROLE_SCENE_ASR_MODEL=
SEEDANCE_ROLE_SCENE_ANALYSIS_ENDPOINT=/api/v3/chat/completions
SEEDANCE_ROLE_SCENE_ASR_ENDPOINT=/api/v3/audio/transcriptions

# Optional Seedream model used to generate target reference images.
SEEDANCE_ROLE_SCENE_SEEDREAM_MODEL=doubao-seedream-5-0-lite-260128
SEEDANCE_ROLE_SCENE_SEEDREAM_SIZE=2K

# Polling and timeout settings, in seconds.
SEEDANCE_ROLE_SCENE_REQUEST_TIMEOUT=120
SEEDANCE_ROLE_SCENE_POLL_INTERVAL=10
SEEDANCE_ROLE_SCENE_POLL_MAX_WAIT=1800

# TOS is required for video/audio/image reference mode.
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
TOS_BUCKET=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
